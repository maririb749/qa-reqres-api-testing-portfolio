    "event": [{
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.collectionVariables.set('collectionName', 'Reqres API Testing Portfolio');",
                    "",
                    "const baseUrl = pm.environment.get('baseUrl');",
                    "",
                    "if (!baseUrl) {",
                    "    throw new Error('Missing required environment variable: baseUrl');",
                    "}"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.test('Response does not expose internal implementation details', function () {",
                    "    const responseText = pm.response.text().toLowerCase();",
                    "",
                    "    pm.expect(responseText).to.not.include('stack');",
                    "    pm.expect(responseText).to.not.include('trace');",
                    "    pm.expect(responseText).to.not.include('exception');",
                    "    pm.expect(responseText).to.not.include('sql');",
                    "    pm.expect(responseText).to.not.include('database');",
                    "    pm.expect(responseText).to.not.include('internal server');",
                    "    pm.expect(responseText).to.not.include('node_modules');",
                    "});"
                ]
            }
        }
    ],
